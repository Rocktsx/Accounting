@page
@using Accounting
@using Accounting.Web
@using Accounting.Web.Menus
@using Accounting.Localization
@using Accounting.Web.Pages.Receivable.DebtorAgingReports
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inject IStringLocalizer<AccountingResource> L
@model Accounting.Web.Pages.Receivable.DebtorAgingReports.SummaryMultipleCurrencyReportModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.ReceivableAgingReports.AgingSummaryMultipleCurrency].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.Receivable]);
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.ReceivableAgingReports.Name]);
    PageLayout.Content.MenuItemName = AccountingMenus.ReceivableAgingReports.AgingSummaryMultipleCurrency;
}
@section content_toolbar {
    @await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(SummaryMultipleCurrencyReportModel).FullName })
}
@section styles {
    <abp-style src="/libs/print-js/print.css" />
    <abp-style src="/global-printa4landscape.css" />
}
@section scripts
{
    <abp-script src="/libs/vue/vue.global.prod.js"></abp-script>
    <abp-script src="/libs/pinia/pinia.iife.prod.js"></abp-script>
    <abp-script src="/libs/select2/js/i18n/@(Helpers.GetSelect2LanguageName()).js"></abp-script>
    <abp-script src="/libs/print-js/print.js"></abp-script>
    <abp-script src="/Pages/Receivable/DebtorAgingReports/SummaryMultipleCurrencyReport.cshtml.js"></abp-script>
}
<abp-card>
    <abp-card-header>
        <form id="searchForm">
            <abp-row class="mb-1">
                <abp-column class="row">
                    <label for="clientId" class="form-label col-sm-3 text-end">@L["Client"].Value</label>
                    <div class="col-sm-9">
                        <select class="form-control" id="clientId" name="clientId"></select>
                    </div>
                </abp-column> 
                <abp-column class="row">
                    <label for="endDate" class="form-label col-sm-4 text-end">@L["Date"].Value</label>
                    <div class="col-sm-8">
                        <input type="date" class="form-control" id="endDate" name="endDate" value="@DateTime.Now.ToString(AccountingCommonConsts.StandardDateFormat)">
                    </div>
                </abp-column>
                <abp-column class="row">
                    <label for="agingDays" class="form-label col-sm-4 text-end">@L["AgingDay"].Value</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" id="agingDays" name="agingDays" value="7">
                    </div>
                </abp-column>
            </abp-row>
        </form>
    </abp-card-header>
    <abp-card-body>
        <div id="app">
        </div>
    </abp-card-body>
</abp-card>

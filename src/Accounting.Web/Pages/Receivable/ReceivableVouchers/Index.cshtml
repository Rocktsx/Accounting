@page
@using Accounting
@using Accounting.Web
@using Accounting.Web.Menus
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Accounting.Web.Pages.Receivable.ReceivableVouchers
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService
@inject IPageLayout PageLayout
@model Accounting.Web.Pages.Receivable.ReceivableVouchers.IndexModel
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.ReceivableVoucher].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.Receivable]);
    PageLayout.Content.MenuItemName = AccountingMenus.ReceivableVoucher;
}
@section scripts
{
    <abp-script src="/libs/vue/vue.global.prod.js"></abp-script>
    <abp-script src="/libs/pinia/pinia.iife.prod.js"></abp-script>
    <abp-script src="/libs/select2/js/i18n/@(Helpers.GetSelect2LanguageName()).js"></abp-script>
    <abp-script src="/Pages/Receivable/ReceivableVouchers/Index.cshtml.js"></abp-script>
}
<style>
    .table thead th {
        font-size: 1em;
    }

    #details-tab-pane .items {
        overflow: auto;
    }

    .select2-container--default .select2-results > .select2-results__options {
        max-height: 350px;
    } 
</style>
@section content_toolbar {
    @await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(IndexModel).FullName })
}
<abp-card>
    <abp-card-header>
        <form id="searchForm">
            <abp-row class="mb-1">
                <abp-column class="row">
                    <label for="code" class="form-label col-sm-3 text-end">@L["Code"].Value</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control form-control-sm" id="code" name="code" placeholder="RV-0001">
                    </div>
                </abp-column>
                <abp-column class="row">
                    <label for="startDate" class="form-label col-sm-3 text-end">@L["VoucherDate"].Value</label>
                    <div class="col-sm-9 row pe-0">
                        <div class="col pe-1">
                            <input type="date" class="form-control form-control-sm" id="startDate" name="startDate" value="@Model.CurrentPeriod.StartDate.ToString(AccountingCommonConsts.StandardDateFormat)">
                        </div>
                        <div class="col ps-1 pe-0">
                            <input type="date" class="form-control form-control-sm" id="endDate" name="endDate" value="@Model.CurrentPeriod.EndDate.ToString(AccountingCommonConsts.StandardDateFormat)">
                        </div>
                    </div>
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column class="row">
                    <label for="startNo" class="form-label col-sm-3 text-end">&nbsp;</label>
                    <div class="col-sm-9 row pe-0">
                        <div class="col pe-1">
                            <input type="text" class="form-control form-control-sm" id="prefix" name="prefix" placeholder="RV">
                        </div>
                        <div class="col px-1">
                            <input type="text" class="form-control form-control-sm" id="startNo" name="startNo" placeholder="0">
                        </div>
                        <div class="col ps-1 pe-0">
                            <input type="text" class="form-control form-control-sm" id="endNo" name="endNo" placeholder="99">
                        </div>
                    </div>
                </abp-column>
                <abp-column class="row">
                    <label for="docNo" class="form-label col-sm-3 text-end">@L["DocNo"].Value</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control form-control-sm" id="docNo" name="docNo">
                    </div>
                </abp-column>
            </abp-row>
        </form>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="voucherTable" striped-rows="true" />
    </abp-card-body>
</abp-card>
<div id="app">
</div>
@page
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@inject IStringLocalizer<AccountingResource> L
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Accounting.Web.Pages.GenenalLedger.AccountingPeriod.CreateModalModel
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Item" id="periodForm" data-ajaxform="true" asp-page="/GenenalLedger/AccountingPeriod/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["NewAccountingPeriod"].Value">
        </abp-modal-header>
        <abp-modal-body>
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
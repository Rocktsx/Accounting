@page
@using Accounting.Permissions
@using Accounting.Web.Menus
@using Accounting.Web.Pages.BasicData.Vendor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService
@model Accounting.Web.Pages.BasicData.Vendor.IndexModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.Vendor].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.BasicData]);
    PageLayout.Content.MenuItemName = AccountingMenus.Vendor;
}
@section scripts
{
    <abp-script src="/basicData/company.js" />
}
@section content_toolbar {
    @await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(IndexModel).FullName })
}
<abp-card>
    <abp-card-body>
        <abp-table id="companyTable" striped-rows="true" data-isvendor="1" />
    </abp-card-body>
</abp-card>
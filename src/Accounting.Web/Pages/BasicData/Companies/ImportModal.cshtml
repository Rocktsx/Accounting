@page
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<AccountingResource> L
@model Accounting.Web.Pages.BasicData.Companies.ImportModalModel
@{
    Layout = null;
}
<form id="importCompanyForm" data-check-form-on-close="false" data-ajaxform="true" method="post"
      enctype="multipart/form-data" action="/api/companies/@(Model.IsVendor? "vendors": "clients")/import">
    <abp-modal>
        <abp-modal-header title="@L[Model.IsVendor ? "ImportVendor" : "ImportClient"].Value">
        </abp-modal-header>
        <abp-modal-body>
            <div class="mb-3">
                <label for="file" class="form-label">@L["ImportFileLabel"]</label>
                <input type="file" id="file" name="file" accept=".csv, .xlsx" class="form-control" />
            </div>
            <div class="text-info mb-1">@L["OnlyImportFiles"]</div>
            <div><a href="/api/templates/CompanyTemplate" target="_blank">@L["TemplateFile"]</a></div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form> 
@page
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<AccountingResource> L
@model Accounting.Web.Pages.BasicData.Client.CreateContactModalModel
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Contact" id="contactForm" data-ajaxForm="true" data-check-form-on-close="false">
    <abp-modal>
        <abp-modal-header title="@(Model.HttpContext.Request.Query["isEdit"] == "true" ? L["EditContact"].Value : L["NewContact"].Value)">
        </abp-modal-header>
        <abp-modal-body>
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.
                                      Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
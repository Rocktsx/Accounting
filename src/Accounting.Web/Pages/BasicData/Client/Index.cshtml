@page

@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService
 @model Accounting.Web.Pages.BasicData.Client.IndexModel
@{
}
@section scripts
{
    <abp-script src="/basicData/company.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row class="mb-1">
            <abp-column size-md="_6">
                <abp-card-title>@L["Menu:Client"]</abp-card-title>
            </abp-column> 
            <abp-column size-md="_6" class="text-end">  
                <abp-button id="newCompanyBtn"
                            text="@L["NewClient"].Value"
                            icon="plus"
                            button-type="Primary" />
            </abp-column>
        </abp-row> 
    </abp-card-header>
    <abp-card-body>
        <abp-table id="companyTable" striped-rows="true" />
    </abp-card-body>
</abp-card>
@page

@using Accounting.Permissions
@using Accounting.Web.Menus
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService
@model Accounting.Web.Pages.BasicData.Client.IndexModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.Client].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.BasicData]);
    PageLayout.Content.MenuItemName = AccountingMenus.Client;
}
@section scripts
{
    <abp-script src="/basicData/company.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row class="mb-1">
            <abp-column size-md="_6">
                <abp-card-title>@L[AccountingMenus.DisplayNames.Client].Value</abp-card-title>
            </abp-column> 
            <abp-column size-md="_6" class="text-end">
                @if(await AuthorizationService.IsGrantedAsync(AccountingPermissions.ClientCreation)) 
                {
                    <abp-button id="newCompanyBtn"
                                text="@L["NewClient"].Value"
                                icon="plus"
                                button-type="Primary" />
                }
            </abp-column>
        </abp-row> 
    </abp-card-header>
    <abp-card-body>
        <abp-table id="companyTable" striped-rows="true" />
    </abp-card-body>
</abp-card>
@page
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<AccountingResource> L
@model Accounting.Web.Pages.BasicData.Currencies.EditModal
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Currency" id="currencyForm" data-ajaxForm="true" data-edit="true"
                  asp-page="/BasicData/Currencies/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["EditCurrency"].Value">
        </abp-modal-header>
        <abp-modal-body>
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.
			Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
<script src="~/basicData/currencyModal.js" asp-append-version="true"></script>
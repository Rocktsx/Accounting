@page
@using Accounting.Web.Menus
@using Accounting.Web.Pages.BasicData.Currency
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout 
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService

@model Accounting.Web.Pages.BasicData.Currency.IndexModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.Currency].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.BasicData]);
    PageLayout.Content.MenuItemName = AccountingMenus.Currency;
}
@section scripts
{
    <abp-script src="/Pages/BasicData/Currency/Index.cshtml.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column>
                <abp-card-title>@L[AccountingMenus.DisplayNames.Currency].Value</abp-card-title>
            </abp-column>
            <abp-column class="text-end">
                 @if (await AuthorizationService.IsGrantedAsync(Accounting.Permissions.AccountingPermissions.CurrencyCreation))
                {
                     <abp-button id="newCurrencyButton"
                            text="@L["NewCurrency"].Value"
                            icon="plus"
                            button-type="Primary" />
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="currencyTable" striped-rows="true" />
    </abp-card-body>
</abp-card>
@page
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@inject IStringLocalizer<AccountingResource> L
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Accounting.Web.Pages.BasicData.Currency.CreateModal
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Currency" id="currencyForm" data-ajaxForm="true"
                  asp-page="/BasicData/Currency/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["NewCurrency"].Value">
        </abp-modal-header>
        <abp-modal-body>
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.
			Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
<script src="~/basicData/currencyModal.js" asp-append-version="true"></script>
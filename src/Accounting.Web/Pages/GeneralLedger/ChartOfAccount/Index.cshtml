@page
@using Accounting.Web.Menus
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Accounting.Web.Pages.GeneralLedger.ChartOfAccount;
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService
@model Accounting.Web.Pages.GeneralLedger.ChartOfAccount.IndexModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.Subject].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.GeneralLedger]);
    PageLayout.Content.MenuItemName = AccountingMenus.Subject;
}
@section styles{
    <abp-style src="/libs/bootstrap-treeview/bootstrap-treeview.min.css" />
}
@section scripts
{
    <abp-script src="/libs/bootstrap-treeview/bootstrap-treeview.min.js"></abp-script>
    <abp-script src="/Pages/GeneralLedger/ChartOfAccount/Index.cshtml.js" />
}
<style>
    .title {
        margin-bottom: 0.25rem;
        font-weight: 500;
        width: 130px;
        padding-right: 10px;
    }

    .ga {
        background-color: #f8f9fa !important;
    }
    .ga-title {
        font-size: 1rem !important;
        font-weight: 400 !important;
    } 
    #showDetail i.fa.fa-check {
        color: #4fbf67;
    }
</style>
@section content_toolbar {
    @await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(IndexModel).FullName })
}
<abp-card>
    <abp-card-body>
        <abp-row>
            <abp-column size-md="_4">
                <div id="coaTree"></div>
            </abp-column>
            <abp-column size-md="_8">
                <abp-card class="ga">
                    <abp-card-header class="pt-2">
                        <abp-card-title class="ga-title">@L["GeneralAccount"]</abp-card-title>
                    </abp-card-header>
                    <abp-card-body class="pb-0 pt-2">
                        <abp-row>
                            <abp-column size="_4">
                                <label class="title">@L["GeneralCode"]</label><span id="subjectCategoryCode"></span>
                            </abp-column>
                            <abp-column size="_8">
                                <label class="title">@L["Name"]</label><span id="name"></span>
                            </abp-column>
                        </abp-row>
                        <abp-row>
                            <abp-column size="_4">
                                <label class="title">@L["AccountType"]</label><span id="accountType"></span>
                            </abp-column>
                            <abp-column size="_8">
                                <label class="title">@L["OtherName"]</label><span id="otherName"></span>
                            </abp-column>
                        </abp-row>
                        <abp-row>
                            <abp-column>
                                <label class="title">@L["ParentCode"]</label><span id="parentCode"></span>
                            </abp-column>
                            <abp-column>
                                <label class="title">@L["DebitorCreditor"]</label><span id="debitorCreditor"></span>
                            </abp-column>
                            <abp-column>
                                <label class="title">@L["ShowDetail"]</label><span id="showDetail"></span>
                            </abp-column>
                        </abp-row>
                    </abp-card-body>
                </abp-card>
                <abp-card class="ga">
                    <abp-card-header class="pt-2">
                        <abp-card-title class="ga-title">@L["Subject"]</abp-card-title>
                    </abp-card-header>
                    <abp-card-body class="pt-0">
                        <abp-table id="subjectTable" striped-rows="true" />
                    </abp-card-body>
                </abp-card> 
            </abp-column>
        </abp-row>
    </abp-card-body>
</abp-card>
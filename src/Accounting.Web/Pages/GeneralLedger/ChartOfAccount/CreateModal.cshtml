@page
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<AccountingResource> L
@model Accounting.Web.Pages.GeneralLedger.ChartOfAccount.CreateModalModel
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Item" id="subjectForm" data-ajaxform="true" column-size="_6" 
                  asp-page="/GeneralLedger/ChartOfAccount/CreateModal">
    <abp-modal size="ExtraLarge">
        <abp-modal-header title="@L["NewSubject"].Value">
        </abp-modal-header>
        <abp-modal-body>
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
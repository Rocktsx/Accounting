@page
@using Accounting.Web.Menus
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService

@model Accounting.Web.Pages.GeneralLedger.AccountingPeriod.IndexModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.AccountingPeriod].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.GeneralLedger]);
    PageLayout.Content.MenuItemName = AccountingMenus.AccountingPeriod;
}
@section scripts
{
    <abp-script src="/Pages/GeneralLedger/AccountingPeriod/Index.cshtml.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column>
                <abp-card-title>@L[AccountingMenus.DisplayNames.AccountingPeriod].Value</abp-card-title>
            </abp-column>
            <abp-column class="text-end">
                @if (await AuthorizationService.IsGrantedAsync(Accounting.Permissions.AccountingPermissions.AccountingPeriodCreation))
                {
                    <abp-button id="newAccountingPeriodBtn"
                                text="@L["NewAccountingPeriod"].Value"
                                icon="plus"
                                button-type="Primary" />
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="accountingPeriodTable" striped-rows="true" />
    </abp-card-body>
</abp-card>
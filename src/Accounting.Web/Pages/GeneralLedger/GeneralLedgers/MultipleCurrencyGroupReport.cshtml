@page
@using Accounting
@using Accounting.Web
@using Accounting.Web.Menus
@using Accounting.Localization
@using Accounting.Web.Pages.GeneralLedger.GeneralLedgers
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inject IStringLocalizer<AccountingResource> L
@model Accounting.Web.Pages.GeneralLedger.GeneralLedgers.MultipleCurrencyGroupReportModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.GeneralLedgers.MultipleCurrencyGroupReport].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.GeneralLedger]);
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.GeneralLedgers.Name]);
    PageLayout.Content.MenuItemName = AccountingMenus.GeneralLedgers.MultipleCurrencyGroupReport;
}
@section content_toolbar {
    @await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(MultipleCurrencyGroupReportModel).FullName })
}
@section scripts
{
    <abp-script src="/libs/vue/vue.global.prod.js"></abp-script>
    <abp-script src="/libs/pinia/pinia.iife.prod.js"></abp-script>
    <abp-script src="/libs/select2/js/i18n/@(Helpers.GetSelect2LanguageName()).js"></abp-script>
    <abp-script src="/Pages/GeneralLedger/GeneralLedgers/MultipleCurrencyGroupReport.cshtml.js"></abp-script>
}
<abp-card>
    <abp-card-header>
        <form id="searchForm">
            <abp-row class="mb-1">
                <abp-column class="row">
                    <label for="subjectId" class="form-label col-sm-3 text-end">@L["Subject"].Value</label>
                    <div class="col-sm-9">
                        <select class="form-control" id="subjectId" name="subjectId"></select>
                    </div>
                </abp-column>
                <abp-column class="row">
                    <label for="periodId" class="form-label col-sm-4 text-end">@L["AccountingPeriod"].Value</label>
                    <div class="col-sm-8">
                        <select value="@Model.PeriodId" type="text" class="form-control" id="periodId" name="periodId">
                            @foreach (var item in Model.Periods)
                            {
                                <option value="@item.Id" data-start-date="@item.StartDate" data-end-date="@item.EndDate">@item.Code</option>
                            }
                        </select>
                    </div>
                </abp-column>
                <abp-column class="row">
                    <label for="startDate" class="form-label col-sm-3 text-end">@L["VoucherDate"].Value</label>
                    <div class="col-sm-9 row pe-0">
                        <div class="col pe-1">
                            <input type="date" class="form-control" id="startDate" name="startDate" value="@Model.CurrentPeriod.StartDate.ToString(AccountingCommonConsts.StandardDateFormat)">
                        </div>
                        <div class="col ps-1 pe-0">
                            <input type="date" class="form-control" id="endDate" name="endDate" value="@Model.CurrentPeriod.EndDate.ToString(AccountingCommonConsts.StandardDateFormat)">
                        </div>
                    </div>
                </abp-column>
            </abp-row>
        </form>
    </abp-card-header>
    <abp-card-body>
        <div id="app">
        </div>
    </abp-card-body>
</abp-card>

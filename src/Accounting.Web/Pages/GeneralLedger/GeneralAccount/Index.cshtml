@page
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService

@model Accounting.Web.Pages.GeneralLedger.GeneralAccount.IndexModel
@section scripts
{
    <abp-script src="/Pages/GeneralLedger/GeneralAccount/Index.cshtml.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["Menu:GeneralAccount"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (await AuthorizationService.IsGrantedAsync(Accounting.Permissions.AccountingPermissions.GeneralAccountCreation))
                {
                    <abp-button id="newGeneralAccountBtn"
                                text="@L["NewGeneralAccount"].Value"
                                icon="plus"
                                button-type="Primary" />
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="generalAccountTable" striped-rows="true" />
    </abp-card-body>
</abp-card>
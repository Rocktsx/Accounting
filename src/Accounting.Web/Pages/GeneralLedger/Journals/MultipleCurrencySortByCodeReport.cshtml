@page
@using Accounting
@using Accounting.Web
@using Accounting.Web.Menus
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Accounting.Localization
@using Accounting.Web.Pages.GeneralLedger.Journals
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inject IStringLocalizer<AccountingResource> L
@inject IAuthorizationService AuthorizationService
@model Accounting.Web.Pages.GeneralLedger.Journals.MultipleCurrencySortByCodeReportModel
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L[AccountingMenus.DisplayNames.Journals.MultipleCurrencySortByCodeReport].Value;
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.GeneralLedger]);
    PageLayout.Content.BreadCrumb.Add(L[AccountingMenus.DisplayNames.Journals.Name]);
    PageLayout.Content.MenuItemName = AccountingMenus.Journals.MultipleCurrencySortByCodeReport;
}
@section scripts
{
    <abp-script src="/libs/vue/vue.min.js"></abp-script>
    <abp-script src="/libs/vuex/vuex.min.js"></abp-script>
    <abp-script src="/libs/select2/js/i18n/@(Helpers.GetSelect2LanguageName()).js"></abp-script>
    <abp-script src="/Pages/GeneralLedger/Journals/MultipleCurrencySortByCodeReport.cshtml.js"></abp-script>
}

@section content_toolbar {
    @await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(MultipleCurrencySortByCodeReportModel).FullName })
}
<abp-card>
    <abp-card-header>
        <form id="searchForm">
            <abp-row class="mb-1">
                <abp-column class="row">
                    <label for="code" class="form-label col-sm-3 text-end">@L["Code"].Value</label>
                    <div class="col-sm-9 row">
                        <div class="col pe-1">
                            <input type="text" class="form-control form-control-sm" id="prefix" name="prefix" placeholder="JV">
                        </div>
                        <div class="col px-1">
                            <input type="text" class="form-control form-control-sm" id="startNo" name="startNo" placeholder="0">
                        </div>
                        <div class="col ps-1 pe-0">
                            <input type="text" class="form-control form-control-sm" id="endNo" name="endNo" placeholder="99">
                        </div>
                    </div>
                </abp-column>
                <abp-column class="row">
                    <label for="startDate" class="form-label col-sm-3 text-end">@L["VoucherDate"].Value</label>
                    <div class="col-sm-9 row pe-0">
                        <div class="col pe-1">
                            <input type="date" class="form-control form-control-sm" id="startDate" name="startDate" value="@Model.CurrentPeriod.StartDate.ToString(AccountingCommonConsts.StandardDateFormat)">
                        </div>
                        <div class="col ps-1 pe-0">
                            <input type="date" class="form-control form-control-sm" id="endDate" name="endDate" value="@Model.CurrentPeriod.EndDate.ToString(AccountingCommonConsts.StandardDateFormat)">
                        </div>
                    </div>
                </abp-column>
                <abp-column class="row">
                    <label for="voucherType" class="form-label col-sm-4 text-end">@L["VoucherType"].Value</label>
                    <div class="col-sm-8">
                        <select type="text" class="form-control form-control-sm" id="voucherType" name="voucherType" asp-items="Model.VoucherTypes"></select>
                    </div>
                </abp-column>
            </abp-row> 
        </form>
    </abp-card-header>
    <abp-card-body>
        <div id="app">
        </div>
    </abp-card-body>
</abp-card>

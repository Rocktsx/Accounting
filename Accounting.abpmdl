      "folder": "src"
    },
    "Accounting.HttpApi": {
      "path": "src/Accounting.HttpApi/Accounting.HttpApi.abppkg",
      "folder": "src"
    },
    "Accounting.HttpApi.Client": {
      "path": "src/Accounting.HttpApi.Client/Accounting.HttpApi.Client.abppkg",
      "folder": "src"
    },
    "Accounting.Web": {
      "path": "src/Accounting.Web/Accounting.Web.abppkg",
      "folder": "src"
    },
    "Accounting.Web.Tests": {
      "path": "test/Accounting.Web.Tests/Accounting.Web.Tests.abppkg",

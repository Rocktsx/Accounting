{
  "template": "app",
  "imports": {
    "Volo.Abp.LeptonXLiteTheme": {
      "version": "5.3.0",
      "isInstalled": true
    },
    "Volo.Abp.Account": {
      "version": "10.3.0",
      "isInstalled": true
    },
    "Volo.Abp.OpenIddict": {
      "version": "10.3.0",
      "isInstalled": true
    },
    "Volo.Abp.Identity": {
      "version": "10.3.0",
